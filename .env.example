# ---------------- Supabase ----------------
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Connect (top of the dashboard) -> Connection String -> Method: "Session pooler"  (NOT "Direct connection":
# db.<ref>.supabase.co needs IPv6 and times out on most home networks).
# The user is postgres.<project-ref> and the host contains your region, e.g. ap-south-1 (Mumbai), ap-northeast-1 (Tokyo).
# Replace [YOUR-PASSWORD] with your database password (no square brackets).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------------- Google Gemini ----------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# gemini-2.5-flash is no longer available to new API keys. If the model below is not available for your key,
# the app automatically switches to the newest available Gemini Flash model (shown in Profile -> System status).
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: a second model to use when the main one is busy (error 503). Leave empty to only retry.
GEMINI_FALLBACK_MODEL=

# ---------------- RAGFlow (local Docker) ----------------
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=ragflow-xxxxxxxxxxxxxxxxxxxxxxxx
# Set to false to disable RAGFlow; chatbot then answers with Gemini over the stored DB data
RAGFLOW_ENABLED=true

# ---------------- Scraper ----------------
# Seconds to wait between requests to screener.in (be polite)
SCRAPER_DELAY_SECONDS=1.0
# Optional: your own screener.in "sessionid" cookie value (logged-in pages show more history)
SCREENER_SESSIONID=

# ---------------- Other websites (analysis report only) ----------------
# Screener is always the main source and the scrape never touches these sites.
# When a report is generated, figures Screener does not publish are looked up here.
EXTERNAL_SOURCES_ENABLED=true
# NSE, Value Research (stock page) and Yahoo Finance are read directly; Investing.com and Macrotrends are searched by Gemini.
EXTERNAL_SITES=finance.yahoo.com,valueresearchonline.com,investing.com,macrotrends.net
# true = keep an AI-searched value only if Google Search really returned a page from that website
EXTERNAL_STRICT=true

# ---------------- News ----------------
# Headlines fetched and kept per website (shown in the app)
NEWS_PER_SOURCE=15
# Main headlines per website in the analysis report (app and PDF), and the most the PDF prints in total
REPORT_NEWS_PER_SOURCE=5
PDF_NEWS_MAX=70

# ---------------- Report checks (guardrails) ----------------
# Every report is checked automatically. Readers see a one-line note and data notes; the full check log is in the
# app (closed box at the end of the report, and Profile -> System status -> Report check log) and in the database
# table report_quality_checks. Set true only for demos / reviews to also print the full log in the PDF.
QUALITY_DETAILS_IN_PDF=false

# ---------------- Google TimesFM AI forecasting model ----------------
# Its own forecast is shown in the analysis report and it also joins the weighted base case.
# Needs PyTorch: setup_windows.bat installs it (manually: pip install "timesfm[torch]").
# If it is not installed the report still works and says why TimesFM is missing.
TIMESFM_ENABLED=true
# 2.5 weights are Apache-2.0 (any use). 3.0 weights (google/timesfm-3.0-pytorch) are non-commercial only.
TIMESFM_CHECKPOINT=google/timesfm-2.5-200m-pytorch
# cpu, or cuda if you have an NVIDIA GPU
TIMESFM_DEVICE=cpu
